+static void watchBubblePlugParent (pid_t parent)
+{
+	dispatch_after (dispatch_time (DISPATCH_TIME_NOW, NSEC_PER_SEC),
+	                dispatch_get_main_queue (), ^{
+		if (getppid () != parent)
+			_exit (0);
+		watchBubblePlugParent (parent);
+	});
+}
+
 //------------------------------------------------------------------------
 @implementation VSTSDK_AppDelegate
 
@@ -195,9 +211,49 @@ - (BOOL)application:(NSApplication*)sender openFile:(NSString*)filename
 //------------------------------------------------------------------------
 - (void)applicationDidFinishLaunching:(NSNotification*)notification
 {
+	watchBubblePlugParent (getppid ());
 	[self setupMenubar];
 	Steinberg::Vst::EditorHost::Platform::instance ().application->init (cmdArgs);
 	cmdArgs.clear ();
+	const char* output = getenv ("BUBBLEPLUG_CAPTURE_OUTPUT");
+	if (output && output[0])
+	{
+		NSString* outputPath = [NSString stringWithUTF8String:output];
+		const char* delayValue = getenv ("BUBBLEPLUG_CAPTURE_DELAY_MS");
+		int delayMs = delayValue ? atoi (delayValue) : 1500;
+		if (delayMs < 100 || delayMs > 10000)
+			delayMs = 1500;
+		dispatch_after (dispatch_time (DISPATCH_TIME_NOW, (int64_t) (delayMs * NSEC_PER_MSEC)),
+		                dispatch_get_main_queue (), ^{
+			NSWindow* editor = nil;
+			for (NSWindow* candidate in NSApp.windows)
+				if (candidate.isVisible && [candidate.title isEqualToString:@"Editor"])
+				{
+					editor = candidate;
+					break;
+				}
+			if (!editor)
+				exit (3);
+			CGImageRef image = CGWindowListCreateImage (CGRectNull,
+			    kCGWindowListOptionIncludingWindow, (CGWindowID)editor.windowNumber,
+			    kCGWindowImageBoundsIgnoreFraming);
+			if (!image)
+				exit (4);
+			NSURL* url = [NSURL fileURLWithPath:outputPath];
+			CGImageDestinationRef destination = CGImageDestinationCreateWithURL (
+			    (__bridge CFURLRef)url, CFSTR ("public.jpeg"), 1, nullptr);
+			if (!destination)
+			{
+				CGImageRelease (image);
+				exit (5);
+			}
+			CGImageDestinationAddImage (destination, image, nullptr);
+			bool saved = CGImageDestinationFinalize (destination);
+			CFRelease (destination);
+			CGImageRelease (image);
+			_exit (saved ? 0 : 6);
+		});
+	}
 }
 
