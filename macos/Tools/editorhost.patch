 		{
 			if (++it != end)
@@ -270,6 +280,34 @@ options:
 	}
 
 	PluginContextFactory::instance ().setPluginContext (&pluginContext);
+	if (listClasses)
+	{
+		std::string error;
+		auto listedModule = VST3::Hosting::Module::create (cmdArgs.back (), error);
+		if (!listedModule)
+			IPlatform::instance ().kill (2, error);
+		for (const auto& info : listedModule->getFactory ().classInfos ())
+			if (info.category () == kVstAudioEffectClass)
+				std::cout << info.ID ().toString () << '\t' << info.name () << '\t'
